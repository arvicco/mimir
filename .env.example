# mimir environment -- names only, real values live in
# ~/.config/mimir/env (sourced by cron), never in the repo.

# Cloudflare (Phase 2+). Canonical names = wrangler's own (one-token
# ruling, Gate 4); publisher and wrangler share all three. The token
# carries BOTH permission sets: Workers KV Storage write + Workers
# Scripts edit (+ User Details read for wrangler whoami).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
DEPLOY_NAME=             # REQUIRED for rake deploy: worker name = public hostname;
                         # pick mimir-<random> (D4-c: unguessable; no silent default)

# Existing suites
FRED_API_KEY=            # scenario/macro.rb; module degrades to score 0 without it
COINGLASS_API_KEY=       # scenario/etf_flows.rb keyed fallback (free Hobbyist key: coinglass.com -> API Management)

# Optional
BTC_DATA_DIR=            # runtime data -> $BTC_DATA_DIR/<suite>/ when set
                         # (default: in-tree scripts/<suite>/data/)
PUBLISH_DRY_RUN=1        # publish pipeline writes data/publish_preview/, no network
