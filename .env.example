# mimir environment -- names only, real values live in
# ~/.config/mimir/env (sourced by cron), never in the repo.

# Cloudflare (Phase 2+)
CF_ACCOUNT_ID=
CF_KV_NAMESPACE_ID=
CF_API_TOKEN=            # scoped: Workers KV Storage write, this namespace only

# Existing suites
FRED_API_KEY=            # scenario/macro.rb; module degrades to score 0 without it
COINGLASS_API_KEY=       # scenario/etf_flows.rb keyed fallback (free Hobbyist key: coinglass.com -> API Management)

# Optional
BTC_DATA_DIR=            # runtime data -> $BTC_DATA_DIR/<suite>/ when set
                         # (default: in-tree scripts/<suite>/data/)
PUBLISH_DRY_RUN=1        # publish pipeline writes data/publish_preview/, no network
